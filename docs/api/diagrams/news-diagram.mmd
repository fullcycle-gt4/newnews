
flowchart TD
    Client["Client"] --> API["NewNews API"]
    API --> Validation{"Request valid and safe?"}

    Validation -->|No| Invalid["400 Bad Request"]
    Validation -->|Yes| Route{"Which news route?"}

    Route -->|GET /api/news| Home["Fetch news feed"]
    Route -->|GET /api/news?category=...| Category["Filter news by category"]
    Route -->|GET /api/news?query=...| Search["Search news by text"]
    Route -->|GET /api/news/:id| Detail["Fetch article details"]
    Route -->|GET /api/news/:id/related| Related["Fetch related news"]

    Home --> Cache[("Cache layer")]
    Category --> Cache
    Search --> Cache
    Detail --> Cache
    Related --> Cache

    Cache --> FeedCache{"Feed cache hit?"}
    Cache --> CategoryCache{"Category cache hit?"}
    Cache --> SearchCache{"Search cache hit?"}
    Cache --> ArticleCache{"Article cache hit?"}
    Cache --> RelatedCache{"Related cache hit?"}

    FeedCache -->|Yes| FeedCheck{"Any results found?"}
    CategoryCache -->|Yes| CategoryCheck{"Any results found?"}
    SearchCache -->|Yes| SearchCheck{"Any results found?"}
    ArticleCache -->|Yes| ArticleCheck{"Article found?"}
    RelatedCache -->|Yes| RelatedCheck{"Any results found?"}

    FeedCache -->|No| NewsDB[("News database")]
    CategoryCache -->|No| NewsDB
    SearchCache -->|No| NewsDB
    ArticleCache -->|No| NewsDB
    RelatedCache -->|No| NewsDB

    NewsDB --> CacheUpdate["Store query results in cache"]
    CacheUpdate --> FeedCheck
    CacheUpdate --> CategoryCheck
    CacheUpdate --> SearchCheck
    CacheUpdate --> ArticleCheck
    CacheUpdate --> RelatedCheck

    FeedCheck -->|Yes| Personalization["Personalization + Re-ranking"]
    CategoryCheck -->|Yes| Personalization
    SearchCheck -->|Yes| Personalization

    Personalization --> ListSuccess["200 OK: News results"]

    FeedCheck -->|No| FeedEmpty["200 OK: Empty feed"]
    CategoryCheck -->|No| CategoryEmpty["200 OK: Empty category results"]
    SearchCheck -->|No| SearchEmpty["200 OK: Empty search results"]

    ArticleCheck -->|Yes| ArticleSuccess["200 OK: Article details"]
    ArticleCheck -->|No| ArticleNotFound["404 Not Found"]

    RelatedCheck -->|Yes| RelatedSuccess["200 OK: Related news"]
    RelatedCheck -->|No| RelatedEmpty["200 OK: No related news found"]

    ArticleSuccess -.->|Article view signal| Learning["Track user interaction"]
    Learning --> Profile["Update user preference profile"]
    Profile -.-> Personalization

    classDef client fill:#eef2ff,stroke:#818cf8;
    classDef process fill:#f0fdfa,stroke:#2dd4bf;
    classDef decision fill:#f5f3ff,stroke:#a78bfa;
    classDef data fill:#ecfeff,stroke:#22d3ee;
    classDef success fill:#f0fdf4,stroke:#4ade80;
    classDef error fill:#fef2f2,stroke:#f87171;
    classDef empty fill:#fffbeb,stroke:#fbbf24;

    class Client client;
    class API,Home,Category,Search,Detail,Related,CacheUpdate,Personalization,Learning,Profile process;
    class Validation,Route,FeedCache,CategoryCache,SearchCache,ArticleCache,RelatedCache,FeedCheck,CategoryCheck,SearchCheck,ArticleCheck,RelatedCheck decision;
    class Cache,NewsDB data;
    class ListSuccess,ArticleSuccess,RelatedSuccess success;
    class Invalid,ArticleNotFound error;
    class FeedEmpty,CategoryEmpty,SearchEmpty,RelatedEmpty empty;
