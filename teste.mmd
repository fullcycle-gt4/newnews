erDiagram
    %% CATEGORY ||--o{ NEWS : "has"
    %% CATEGORY ||--o{ NOTIFICATION : "belongs to"
    %% USER ||--o{ FAVORITE : "saves"
    %% USER ||--o{ NOTIFICATION : "receives"
    %% NEWS ||--o{ FAVORITE : "is favorited at"

    CATEGORY {
        int id PK
        string name
        string label
        string icon
    }

    FAVORITE {
        int id PK
        int user_id FK
        int news_id FK
        datetime created_at
    }

    NEWS {
        int id PK
        string title
        string summary
        text content
        string image
        datetime publishedAt
        string author
        string source
        string readTime
        boolean isHero
        string badgeBg
        int categoria_id FK
    }

    USER {
        int id PK
        string name
        string email
        string password_hash
        string avatar
    }

    NOTIFICATION {
        int id PK
        string title
        datetime timeAgo
        int user_id FK
        int category_id FK
    }