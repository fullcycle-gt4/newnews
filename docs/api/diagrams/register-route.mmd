flowchart TD
    Client["Client"] -->|POST /api/auth/register| API["NewNews API"]
    API --> Validate{"Valid request?"}

    Validate -->|No| ValidationError["400 Validation errors"]
    Validate -->|Yes| Exists{"Email already exists?"}

    Exists -->|Yes| DuplicateEmail["409 Email already registered"]
    Exists -->|No| Hash["Hash password"]
    Hash --> Create["Create user record"]
    Create --> DB[("User database")]
    DB --> Token["Generate JWT access token"]
    Token --> Success["201 Created: user + JWT"]

    classDef client fill:#eef2ff,stroke:#818cf8;
    classDef process fill:#f0fdfa,stroke:#2dd4bf;
    classDef decision fill:#f5f3ff,stroke:#a78bfa;
    classDef data fill:#ecfeff,stroke:#22d3ee;
    classDef success fill:#f0fdf4,stroke:#4ade80;
    classDef error fill:#fef2f2,stroke:#f87171;

    class Client client;
    class API,Hash,Create,Token process;
    class Validate,Exists decision;
    class DB data;
    class Success success;
    class ValidationError,DuplicateEmail error;